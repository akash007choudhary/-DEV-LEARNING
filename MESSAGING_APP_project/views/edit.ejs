<body>

    <h1>Create New Chat</h1>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
</head>

<body>

    <h3>Edit Your Chat</h3>

    <form action="/chats/<%= id %>?_method=PUT" method="POST">

        <textarea name="msg" placeholder="Enter new message">
            <%= msg %>
        </textarea>

        <button type="submit">Edit</button>

    </form>

</body>
</html>

</body>
