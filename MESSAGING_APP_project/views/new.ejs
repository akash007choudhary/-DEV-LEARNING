<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Create New Chat</h1>

    <form action="/chats" method="POST">

        <label for="from">From:</label>
        <input type="text" id="from" name="from" placeholder="Enter sender name" required>

        <br><br>

        <label for="to">To:</label>
        <input type="text" id="to" name="to" placeholder="Enter receiver name" required>

        <br><br>

        <label for="message">Message:</label>
        <textarea id="message" name="msg" placeholder="Enter your message" required></textarea>

        <br><br>

        <button type="submit">Create Chat</button>

    </form>

</body>
</html>